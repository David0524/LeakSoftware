<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The iPhone app's privacy manifest (App Store, 2026-10-24). Copied into the app by
  AppHost/project.yml. Keep it in step with the App Privacy answers in
  docs/release/APP_STORE.md and with apps/web/src/app/(public)/privacy/page.tsx.

  Required-reason APIs:
  - UserDefaults CA92.1: the app's own settings (@AppStorage, e.g. whether Schedule's day map
    is open), read only by this app.
  - File timestamp C617.1: the size of files in the app's own container (the database and
    captured media before upload), and SQLite's stat calls on its own database (SQLCipher is
    compiled into the app).
  - Disk space E174.1: SQLite (SQLCipher) checks the file system its database file is on
    before writing it. Nothing about disk space leaves the phone or is shown.
  Sentry, SQLCipher and swift-crypto ship their own manifests.

  No tracking, no tracking domains: the app has no advertising, attribution or analytics SDK.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyCollectedDataTypes</key>
