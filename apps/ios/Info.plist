<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Sundeck Pro</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>Sundeck Pro uses the camera for photos and videos of pools, equipment, and leaks, which go in the job’s report.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Sundeck Pro uses the microphone to record voice notes and the sound on job videos.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Sundeck Pro notes where a job’s photos, videos, voice notes, and signatures are taken, so the report shows the work was done at the pool. It checks only at those moments, never in the background.</string>
	<key>SundeckSupabaseURL</key>
	<string>$(SUNDECK_SUPABASE_URL)</string>
	<key>SundeckSupabaseKey</key>
	<string>$(SUNDECK_SUPABASE_KEY)</string>
	<key>SundeckWebURL</key>
	<string>$(SUNDECK_WEB_URL)</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.sundeckpro.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sundeckpro</string>
			</array>
		</dict>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
