# Copy to apps/web/.env.local. Server-only secrets (service role, Stripe, Resend)
# are read from the root variables listed in /.env.example.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000
# Schedule's enlarged day map (Mapbox GL JS): a public pk. token restricted to the site's URLs.
# Without it, Enlarge shows a larger map image. See /.env.example.
NEXT_PUBLIC_MAPBOX_TOKEN=
