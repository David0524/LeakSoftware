# Server-side and tooling secrets. Copy to .env (never commit real values).
# In the Claude cloud environment, set these in the environment settings instead.

# Supabase (dev project). Local DB tests do not need these.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Local DB tests: optional superuser URL; otherwise the local Postgres cluster is used.
TEST_DATABASE_URL=

# Expo / EAS device builds (M3)
EXPO_TOKEN=

# Speech-to-text (M5)
DEEPGRAM_API_KEY=

# AI narrative (M7)
# Without a key, drafts are a plain summary of the job data.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Email (M7)
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=send.tidemark.app
# Tests only: write emails as JSON files here instead of sending them.
EMAIL_OUTBOX_DIR=

# Report PDFs: a Chromium binary (local and CI). Vercel uses @sparticuz/chromium.
CHROMIUM_PATH=

# Stripe test mode with Connect (M8)
STRIPE_SECRET_KEY=
# The platform's publishable key (pk_...). With it, customers pay on our quote and invoice
# pages (embedded Checkout); without it the Pay button opens Stripe's page.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Company texting and calls (2026-10-16): one Tidemark Twilio account for every shop. Without
# the account SID, texts are saved but not sent and numbers are made up (demo mode). The auth
# token also checks Twilio's webhook signatures. The Messaging Service is the registered US
# texting campaign (A2P 10DLC) new numbers join.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Tidemark's own subscription (M10) uses STRIPE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY; the
# price comes from packages/core/src/plans.ts (no price id). The platform webhook endpoint also
# needs checkout.session.completed and customer.subscription.created/updated/deleted.

# Daily job (M10 reminders and review requests): Vercel Cron sends this as a Bearer token.
CRON_SECRET=

# Routes (M10.5): Mapbox access token (default scopes, no URL restrictions) for the Geocoding
# API (v6, permanent) and the Matrix API. Server only; never in the app or the browser.
# Without it, drive times are estimated.
MAPBOX_TOKEN=
# Calls to Mapbox each shop may make per day (default 300).
ROUTING_DAILY_LIMIT=

# Monitoring (M11). Errors only, no customer data (apps/web/src/lib/sentry.ts). Off when empty.
# The website's server uses SENTRY_DSN; the browser and the phone app use the public copies.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# Tidemark's support mailbox (M11), shown on the status, privacy, and More pages.
SUPPORT_EMAIL=

# Public base URL of the web app (customer links)
APP_BASE_URL=http://localhost:3000

# Debugging: log every database call a page makes, with its time (finding slow pages).
DB_TIMING=
