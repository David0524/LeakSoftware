# Server-side and tooling secrets. Copy to .env (never commit real values).
# In the Claude cloud environment, set these in the environment settings instead.

# Supabase (dev project). Local DB tests do not need these.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# Local DB tests: optional superuser URL; otherwise the local Postgres cluster is used.
TEST_DATABASE_URL=

# Expo / EAS device builds (M3)
EXPO_TOKEN=

# Speech-to-text (M5)
DEEPGRAM_API_KEY=

# Email (M7)
RESEND_API_KEY=
EMAIL_FROM_DOMAIN=send.sundeckpro.com
# Tests only: write emails as JSON files here instead of sending them.
EMAIL_OUTBOX_DIR=

# Report PDFs: a Chromium binary (local and CI). Vercel uses @sparticuz/chromium.
CHROMIUM_PATH=

# Stripe test mode with Connect (M8)
STRIPE_SECRET_KEY=
# The platform's publishable key (pk_...). With it, customers pay on our quote and invoice
# pages (embedded Checkout); without it the Pay button opens Stripe's page.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# Company texting and calls (2026-10-16): one Sundeck Pro Twilio account for every shop. Without
# the account SID, texts are saved but not sent and numbers are made up (demo mode). The auth
# token also checks Twilio's webhook signatures. The Messaging Service is the registered US
# texting campaign (A2P 10DLC) new numbers join.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Sundeck Pro's own subscription (M10) uses STRIPE_SECRET_KEY and SUPABASE_SERVICE_ROLE_KEY; the
# price comes from packages/core/src/plans.ts (no price id). The platform webhook endpoint also
# needs checkout.session.completed and customer.subscription.created/updated/deleted.

# Daily job (M10 reminders and review requests): Vercel Cron sends this as a Bearer token.
CRON_SECRET=

# Routes (M10.5): Mapbox access token (default scopes, no URL restrictions) for address
# suggestions (temporary geocoding), the Matrix API and day-map images. Server only; never in
# the app or the browser. Without it, drive times are estimated. Pools are looked up with the
# free Census and OpenStreetMap geocoders, not Mapbox (its permanent geocoding has no free
# tier). Every Mapbox call stays inside the monthly free tier, for all shops together
# (app.mapbox_budget, about 90% of each tier).
MAPBOX_TOKEN=
# Schedule's enlarged day map (interactive, Mapbox GL JS in the browser): a public pk. token
# restricted to the site's URLs (Mapbox: Tokens > URL restrictions), styles:tiles and
# styles:read scopes only. Without it, Enlarge shows a larger map image. MAPBOX_TOKEN stays
# server-only.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Apple Maps on the website (docs/plans/apple-maps.md): MapKit JS maps, map images (Snapshots)
# and address suggestions, all inside Apple's free daily allowance (app.mapbox_budget's apple_*
# rows). From the Apple Developer account: the Team ID, and a key with MapKit JS and the Maps
# Server API enabled (its Key ID, and the .p8 file's contents, line breaks kept or as \n).
# Server only: the browser gets 30-minute tokens from /api/mapkit-token. Without all three, the
# website uses Mapbox. Drive times stay on Mapbox either way.
APPLE_MAPS_TEAM_ID=
APPLE_MAPS_KEY_ID=
APPLE_MAPS_PRIVATE_KEY=
# apple (the default when the three Apple settings are set) or mapbox, to go back to Mapbox's
# maps without removing the keys.
MAP_PROVIDER=
# Calls to Mapbox each shop may make per day (default 300), on top of the monthly free-tier
# budget.
ROUTING_DAILY_LIMIT=
# Address suggestions (as an address is typed) each shop may ask Mapbox for per day (default 2000).
ADDRESS_SUGGEST_DAILY_LIMIT=
# Daily allowances per shop for work Sundeck Pro pays for (security audit 2026-10-17). Empty uses
# the defaults: email 300 recipients, transcriptions 200, texts 500,
# calls 100.
DAILY_LIMIT_EMAIL=
DAILY_LIMIT_TRANSCRIBE=
DAILY_LIMIT_TEXT=
DAILY_LIMIT_CALL=

# Monitoring (M11). Errors only, no customer data (apps/web/src/lib/sentry.ts). Off when empty.
# The website's server uses SENTRY_DSN; the browser and the phone app use the public copies.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# Sundeck Pro's support mailbox (M11), shown on the status, privacy, and More pages.
SUPPORT_EMAIL=

# Public base URL of the web app (customer links)
APP_BASE_URL=http://localhost:3000

# Debugging: log every database call a page makes, with its time (finding slow pages).
DB_TIMING=

# Sundeck Pro staff who can see the leads list at /admin/leads (comma-separated emails; they
# also need two-step sign-in on). Kept out of the repository, which is public.
SUNDECK_STAFF_EMAILS=
