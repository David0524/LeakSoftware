{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["pdx1"],
  "installCommand": "pnpm install --frozen-lockfile --filter @leakbook/web...",
  "ignoreCommand": "bash \"$(git rev-parse --show-toplevel)/scripts/vercel-ignore.sh\"",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "45 15 * * *"
    }
  ]
}
