{
  "$description": "Tidemark design tokens. Source of truth for the mobile app, office web app, and customer pages. Customer-facing documents (reports, quotes, invoices) use the shop's own brand colors; these tokens are for Tidemark's own UI.",
  "color": {
    "brand": {
      "navy": "#12263A",
      "water": "#1F6FAE",
      "safety": "#EE6A1F",
      "concrete": "#E9ECEF",
      "paper": "#FFFFFF"
    },
    "neutral": {
      "50": "#F5F7F9",
      "100": "#E9ECEF",
      "200": "#D3D9DF",
      "300": "#B5BFC9",
      "400": "#8A97A4",
      "500": "#5A6875",
      "600": "#46535F",
      "700": "#33404C",
      "800": "#22303D",
      "900": "#12263A"
    },
    "status": {
      "pass": "#1B7D45",
      "fail": "#C62F2B",
      "excluded": "#5B6B7A",
      "warning": "#8A5A0E",
      "info": "#1F6FAE"
    },
    "markup": {
      "$description": "Photo markup (arrows, circles, text). Chosen to stand out on photos, not brand colors. Drawn with a dark outline.",
      "red": "#FF3B30",
      "yellow": "#FFD60A",
      "white": "#FFFFFF",
      "outline": "#000000"
    },
    "role": {
      "light": {
        "bg": "#F2F2F7",
        "surface": "#FFFFFF",
        "text": "#12263A",
        "textMuted": "#5A6875",
        "border": "#D3D9DF",
        "header": "#12263A",
        "onHeader": "#FFFFFF",
        "primary": "#1A63A0",
        "onPrimary": "#FFFFFF",
        "link": "#1A63A0",
        "focus": "#1A63A0",
        "diagramWater": "#CFE3F3",
        "onStatus": "#FFFFFF",
        "controlBorder": "#5A6875",
        "chart": "#1F6FAE",
        "fill": "#7676801F",
        "separator": "#3C3C434A",
        "thumb": "#FFFFFF"
      },
      "dark": {
        "bg": "#0E141A",
        "surface": "#161E26",
        "text": "#E6ECF1",
        "textMuted": "#93A2AF",
        "border": "#2A3540",
        "header": "#0B1622",
        "onHeader": "#FFFFFF",
        "primary": "#2B78B8",
        "onPrimary": "#FFFFFF",
        "link": "#6AAEE6",
        "focus": "#6AAEE6",
        "pass": "#3FB36F",
        "fail": "#E5655F",
        "excluded": "#8E9DAB",
        "diagramWater": "#1F3A52",
        "onStatus": "#12263A",
        "controlBorder": "#8A97A4",
        "warning": "#D9A040",
        "info": "#6AAEE6",
        "chart": "#4A93D0",
        "fill": "#7676803D",
        "separator": "#545458A6",
        "thumb": "#636366"
      }
    }
  },
  "font": {
    "display": {
      "family": "Barlow Semi Condensed",
      "weights": [600, 700, 800],
      "use": "Headings, labels, buttons, status chips, wordmark"
    },
    "body": {
      "family": "Public Sans",
      "weights": [400, 500, 600, 700],
      "use": "All running text, form fields, tables. Use tabular numbers for readings. On Apple devices the website uses the system font (San Francisco) for body text and controls instead (owner, 2026-10-14)."
    }
  },
  "radius": {
    "sm": 3,
    "md": 6,
    "lg": 10,
    "xl": 20,
    "pill": 999
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48
  },
  "touch": {
    "minTarget": 48,
    "$description": "Minimum tap target in the field app (gloves, wet hands)."
  }
}
