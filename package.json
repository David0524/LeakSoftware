{
  "name": "leakbook",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:db": "node scripts/test-db.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "pnpm --filter @leakbook/tokens run build",
    "db:deploy": "NODE_USE_ENV_PROXY=1 node scripts/deploy-db.mjs",
    "test:hosted": "NODE_USE_ENV_PROXY=1 pnpm --filter @leakbook/sync test:hosted",
    "test:ios": "swift test --package-path apps/ios",
    "lint:ios": "swift format lint --strict -r apps/ios/Sources apps/ios/Tests apps/ios/Package.swift",
    "build:ios": "bash scripts/build-ios.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22.15.0",
    "eslint": "^9",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "supabase": "2.120.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4"
  }
}
